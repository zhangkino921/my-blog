# ══════════════════════════════════════════════════════
#  赛博朋克红骰子服务器  —  环境配置模板
#  复制此文件为 .env 后填写配置，再运行 npm start
# ══════════════════════════════════════════════════════

# 服务器端口（默认 3000）
PORT=3000

# ── Discord Webhook（单向推送，最简配置）──────────────
# 在 Discord 频道设置 → 整合 → Webhooks → 新建 Webhook → 复制 URL
DISCORD_WEBHOOK_URL=

# ── Discord Bot（双向，支持 DM 指令）─────────────────
# 1. 前往 https://discord.com/developers/applications 创建应用
# 2. Bot 页面 → 开启 Message Content Intent
# 3. 复制 Token 填入下方
# 4. 在 OAuth2 → URL Generator 勾选 bot + Send Messages + Read Messages
#    生成邀请链接，将机器人加入你的服务器
DISCORD_BOT_TOKEN=

# Bot 监听的频道 ID（右键频道 → 复制频道 ID，需开启开发者模式）
# 留空则监听所有频道的 ! 指令
DISCORD_CHANNEL_ID=
